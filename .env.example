# SellSense Environment Configuration
# Copy this file to .env.local and fill in your values

# Application
VITE_APP_NAME=SellSense
VITE_APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001/api

# Zomato API Configuration
# Get these from https://developers.zomato.com/api
VITE_ZOMATO_CLIENT_ID=your_zomato_client_id
VITE_ZOMATO_CLIENT_SECRET=your_zomato_client_secret
VITE_ZOMATO_REDIRECT_URI=http://localhost:5173/zomato-connect

# Zomato API Key (for server-side calls)
ZOMATO_API_KEY=your_zomato_api_key

# Database (use PostgreSQL in production)
DATABASE_URL=postgresql://user:password@localhost:5432/sellsense

# JWT Secret for auth tokens
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Encryption key for sensitive data (32 chars)
ENCRYPTION_KEY=your-32-character-encryption-key

# Redis for caching & rate limiting
REDIS_URL=redis://localhost:6379

# Email service (for notifications)
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@sellsense.ai

# Monitoring
SENTRY_DSN=your_sentry_dsn