# SellSense Backend Environment Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Zomato API Configuration
ZOMATO_CLIENT_ID=your_zomato_client_id
ZOMATO_CLIENT_SECRET=your_zomato_client_secret
ZOMATO_REDIRECT_URI=http://localhost:5173/zomato-connect
ZOMATO_API_KEY=your_zomato_api_key

# Google Business Profile API & Reviews Integration
# Official Docs: https://developers.google.com/my-business/content/implement-oauth
# Google Cloud Console: Enable 'Google My Business API' & 'My Business Business Information API'
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/google-reviews-callback
